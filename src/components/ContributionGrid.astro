---
const { player } = Astro.props;
const skeletonCells = Array.from({ length: 52 * 7 });
---

<div class="contribution-grid" data-contribution-grid={player} aria-label={`${player} contribution calendar`}>
	{skeletonCells.map((_, index) => <span class="day skeleton" data-skeleton={index} aria-hidden="true"></span>)}
</div>

<style>
	.contribution-grid {
		display: grid;
		grid-template-columns: repeat(52, minmax(0, 1fr));
		grid-template-rows: repeat(7, minmax(0, 1fr));
		gap: 0.2rem;
		overflow-x: auto;
		padding: 0.5rem 0;
	}

	:global(.day) {
		aspect-ratio: 1;
		min-width: 0.55rem;
		border-radius: 0.15rem;
		background: #17192a;
		border: 1px solid rgba(255,255,255,0.08);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	:global(.skeleton) {
		background: linear-gradient(90deg, #17192a 25%, #303354 50%, #17192a 75%);
		background-size: 200% 100%;
		animation: shimmer 1.4s infinite;
	}

	:global(.day[data-level='0']) { background: #17192a; box-shadow: none; }
	:global(.day[data-level='1']) { background: #174b4f; box-shadow: 0 0 3px #38f5ff; }
	:global(.day[data-level='2']) { background: #168b89; box-shadow: 0 0 5px #38f5ff; }
	:global(.day[data-level='3']) { background: #27d6a5; box-shadow: 0 0 8px #5fed83; }
	:global(.day[data-level='4']) { background: #d7ff70; box-shadow: 0 0 5px #5fed83, 0 0 12px #d7ff70; }
	:global(.day:not(.skeleton):hover) { transform: scale(1.5); z-index: 1; }

	@keyframes shimmer {
		to { background-position: -200% 0; }
	}
</style>
